{
  "name": "game-hub",
  "version": "0.3.0",
  "private": true,
  "description": "Local Windows game server manager",
  "author": "GameHub contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "node scripts/test.mjs",
    "check:privacy": "node scripts/privacy.mjs",
    "dist": "npm run build && electron-builder --win nsis portable",
    "pack": "npm run build && electron-builder --win --dir",
    "build:server": "tsc --noEmit && vite build --config vite.server.config.ts && node scripts/server-build.mjs",
    "serve": "node dist-server/server.cjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "lucide-react": "^0.468.0",
    "pidusage": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "^5.5.0",
    "sql.js": "^1.13.0",
    "tar": "^7.5.22",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.0"
  },
  "build": {
    "appId": "org.gamehub.desktop",
    "productName": "GameHub",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-electron/ConsoleHost.exe",
        "to": "ConsoleHost.exe"
      },
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "GameHub-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "GameHub-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "GameHub-Portable-${version}-${arch}.${ext}"
    }
  }
}
